# Anthropic API Key (Claude Sonnet 4.6 for profile analysis & live dates)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server Port
PORT=5000

# Optional PostgreSQL Connection URL (falls back to local SQLite/JSON store if not set)
# DATABASE_URL=postgresql://user:password@localhost:5432/agentic_dating

# Mem0 API Key (Optional for cloud vector persistence, local Mem0 store active by default)
# MEM0_API_KEY=your_mem0_api_key_here

# Cloudflare R2 / AWS S3 (Optional for media bucket)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
